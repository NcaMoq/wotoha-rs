# Copy to runtime.env on the production host and set the secret there.
DISCORD_TOKEN=
RUST_LOG=info,wotoha_debug=info
WOTOHA_LOG_FILE=wotoha-app.runtime.log
# Container deployments keep stdout/stderr as the primary bounded log stream.
# Set true only when an optional secondary file log is explicitly required.
WOTOHA_LOG_FILE_ENABLED=false
WOTOHA_LOG_ANSI=false
WOTOHA_DEFAULT_VOLUME=0.10
WOTOHA_LOUDNESS_NORMALIZATION_ENABLED=true
WOTOHA_LOUDNESS_TARGET_LUFS=-16.0
# Default is attenuation-only. Set above 0 only to opt in to positive gain.
WOTOHA_LOUDNESS_MAX_BOOST_DB=0.0
WOTOHA_LOUDNESS_TRUE_PEAK_CEILING_DBTP=-2.0
WOTOHA_MAX_QUEUE_LEN=512
WOTOHA_MAX_PENDING_ENQUEUES=64
WOTOHA_AUTOMIX_ENABLED=true
# Leave planner mode unset to use the compatibility shadow flag below.
# WOTOHA_AUTOMIX_PLANNER_MODE=legacy
WOTOHA_AUTOMIX_V2_SHADOW_ENABLED=false
WOTOHA_AUTOMIX_BEATMATCH_MIN_BEATS=8
WOTOHA_AUTOMIX_BEATMATCH_PREFERRED_BEATS=32
WOTOHA_AUTOMIX_BEATMATCH_MAX_BEATS=64
WOTOHA_AUTOMIX_CROSSFADE_SECONDS=8
WOTOHA_AUTOMIX_MAX_TEMPO_ADJUSTMENT=0.06
WOTOHA_AUTOMIX_MIN_BEAT_CONFIDENCE=0.70
WOTOHA_YTDLP_TIMEOUT_SECONDS=25
WOTOHA_YTDLP_CONCURRENCY=2
# WOTOHA_YTDLP_COOKIES_FILE=/wotoha/cookies.txt
# Compose pins these paths inside the image; keep these only for local overrides.
# WOTOHA_YTDLP_PATH=/wotoha/tools/yt-dlp
