WOTOHA_IMAGE_TAG=sha-<full-git-sha>
# Prefer a content-addressed digest for production rollback identity. When
# set, this full reference takes precedence over WOTOHA_IMAGE_TAG.
# WOTOHA_IMAGE_REF=ghcr.io/ncamoq/wotoha-rs@sha256:<image-digest>
# Optional host-side bind mount; the default is ./data.
# WOTOHA_DATA_DIR=/home/ncamoq/wotoha/data
